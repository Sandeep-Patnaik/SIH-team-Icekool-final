# Copy this file to .env and fill in real values before running anything.
# Every module reads from config.Config, which reads these env vars.

# --- Database & Query Layer (Module 2) ---
DATABASE_URL=postgresql://user:password@localhost:5432/oceanmind

# --- LLM Query Engine (Module 4) ---
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
MCP_SERVER_URL=http://localhost:8080

# --- Vector Store & RAG Pipeline (Module 3 - this module) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Shared logging ---
LOG_LEVEL=INFO
